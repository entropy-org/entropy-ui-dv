{
  "name": "@entropy-ui/data-views",
  "version": "0.1.0-next.2",
  "description": "Controlled React list, kanban, calendar, timeline, and multi-view database components.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/entropy-org/entropy-ui-dv.git",
    "directory": "packages/data-views"
  },
  "homepage": "https://entropy-org.github.io/entropy-ui-dv/",
  "bugs": {
    "url": "https://github.com/entropy-org/entropy-ui-dv/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./adapters": {
      "types": "./dist/core/built-in-plugins.d.ts",
      "import": "./dist/core/built-in-plugins.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./list": {
      "types": "./dist/components/list/index.d.ts",
      "import": "./dist/components/list/index.js"
    },
    "./kanban": {
      "types": "./dist/components/kanban/index.d.ts",
      "import": "./dist/components/kanban/index.js"
    },
    "./calendar": {
      "types": "./dist/components/calendar/index.d.ts",
      "import": "./dist/components/calendar/index.js"
    },
    "./timeline": {
      "types": "./dist/components/timeline/index.d.ts",
      "import": "./dist/components/timeline/index.js"
    },
    "./styles.css": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/styles.css"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build --config vite.styles.config.ts && node scripts/scope-styles.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:storybook": "vitest run --project storybook",
    "lint": "eslint src",
    "storybook": "storybook dev -p 6006 -c .storybook",
    "storybook:build": "storybook build -c .storybook -o ../../storybook-static",
    "bundle:check": "node scripts/check-bundles.mjs",
    "build:verify": "node scripts/verify-build.mjs",
    "package:lint": "publint && attw --profile esm-only --pack .",
    "pack:check": "pnpm pack --pack-destination ../../artifacts"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@date-fns/tz": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-virtual": "^3.14.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.24.0",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@storybook/addon-a11y": "^10.5.0",
    "@storybook/addon-docs": "^10.5.0",
    "@storybook/addon-vitest": "^10.5.0",
    "@storybook/react-vite": "^10.5.0",
    "@tailwindcss/vite": "^4.2.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/browser-playwright": "^4.1.0",
    "jsdom": "^29.1.0",
    "playwright": "^1.61.1",
    "postcss": "^8.5.26",
    "postcss-prefix-selector": "^2.1.1",
    "publint": "^0.3.15",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "storybook": "^10.5.0",
    "tailwindcss": "^4.2.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  }
}
